{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RaghhavMalani/leetcode-progress/main/progress.schema.json",
  "title": "leetcode-progress bridge contract",
  "description": "Repository-owned solution facts consumed by PLAYBOOK-theDSAEngine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "sourceCommit", "repository", "declaredStats", "problems"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "repository": { "type": "string", "format": "uri" },
    "declaredStats": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["solved", "easy", "medium", "hard"],
          "properties": {
            "solved": { "type": ["integer", "null"], "minimum": 0 },
            "easy": { "type": ["integer", "null"], "minimum": 0 },
            "medium": { "type": ["integer", "null"], "minimum": 0 },
            "hard": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      ]
    },
    "problems": {
      "type": "array",
      "items": { "$ref": "#/$defs/problem" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "path"],
      "properties": {
        "available": { "type": "boolean" },
        "path": { "type": ["string", "null"] }
      }
    },
    "solveEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "solvedAt", "languages"],
      "properties": {
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "solvedAt": { "type": "string", "format": "date-time" },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9+#-]+$" }
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "slug",
        "directory",
        "difficulty",
        "classification",
        "languages",
        "artifacts",
        "solutionHashes",
        "firstSolvedAt",
        "lastSolvedAt",
        "reSolveHistory"
      ],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "directory": { "type": "string", "pattern": "^\\d{4}-[a-z0-9-]+$" },
        "difficulty": { "enum": ["", "easy", "medium", "hard"] },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "family"],
          "properties": {
            "label": { "type": "string" },
            "family": { "type": "string" }
          }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9+#-]+$" }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["notes", "trace"],
          "properties": {
            "notes": { "$ref": "#/$defs/artifact" },
            "trace": { "$ref": "#/$defs/artifact" }
          }
        },
        "solutionHashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "firstSolvedAt": { "type": "string", "format": "date-time" },
        "lastSolvedAt": { "type": "string", "format": "date-time" },
        "reSolveHistory": {
          "type": "array",
          "items": { "$ref": "#/$defs/solveEvent" }
        }
      }
    }
  }
}
